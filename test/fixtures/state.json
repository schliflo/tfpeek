{
  "version": 4,
  "terraform_version": "1.17.2",
  "serial": 7,
  "lineage": "00000000-0000-0000-0000-000000000000",
  "outputs": {
    "url": {
      "value": "https://example.test",
      "type": "string"
    },
    "db_dsn": {
      "value": "SECRET-output-marked-sensitive",
      "type": "string",
      "sensitive": true
    },
    "admin_token": {
      "value": "SECRET-output-by-name",
      "type": "string"
    }
  },
  "resources": [
    {
      "mode": "managed",
      "type": "random_password",
      "name": "db",
      "provider": "provider[\"registry.terraform.io/hashicorp/random\"]",
      "instances": [
        {
          "schema_version": 3,
          "attributes": {
            "id": "none",
            "length": 20,
            "result": "SECRET-random-password",
            "bcrypt_hash": "SECRET-bcrypt"
          },
          "sensitive_attributes": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "tls_private_key",
      "name": "oauth",
      "provider": "provider[\"registry.terraform.io/hashicorp/tls\"]",
      "instances": [
        {
          "attributes": {
            "algorithm": "RSA",
            "private_key_pem": "SECRET-pem",
            "private_key_openssh": "SECRET-openssh",
            "private_key_pem_pkcs8": "SECRET-pkcs8",
            "public_key_pem": "public-pem"
          },
          "sensitive_attributes": []
        }
      ]
    },
    {
      "module": "module.api",
      "mode": "managed",
      "type": "google_cloud_run_v2_service",
      "name": "api",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "index_key": "eu",
          "attributes": {
            "name": "api",
            "template": [
              {
                "containers": [
                  {
                    "image": "example/api:1",
                    "env": [
                      {
                        "name": "LOG_LEVEL",
                        "value": "info"
                      },
                      {
                        "name": "SESSION_SECRET",
                        "value": "SECRET-env-by-name"
                      },
                      {
                        "name": "DSN",
                        "value": "SECRET-by-path"
                      }
                    ]
                  }
                ]
              }
            ],
            "client_secret": "SECRET-attr-by-name",
            "private": "not-a-secret-key-name"
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "template"
              },
              {
                "type": "index",
                "value": {
                  "value": 0,
                  "type": "number"
                }
              },
              {
                "type": "get_attr",
                "value": "containers"
              },
              {
                "type": "index",
                "value": {
                  "value": 0,
                  "type": "number"
                }
              },
              {
                "type": "get_attr",
                "value": "env"
              },
              {
                "type": "index",
                "value": {
                  "value": 2,
                  "type": "number"
                }
              },
              {
                "type": "get_attr",
                "value": "value"
              }
            ]
          ],
          "private": "SECRET-provider-private-blob",
          "dependencies": [
            "random_password.db"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_instance",
      "name": "vm",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "vm",
            "metadata_startup_script": "export DB=SECRET-startup-script",
            "metadata": {
              "startup-script": "SECRET-metadata-script",
              "team": "infra"
            }
          },
          "sensitive_attributes": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "app",
      "provider": "provider[\"registry.terraform.io/hashicorp/helm\"]",
      "instances": [
        {
          "attributes": {
            "name": "app",
            "chart": "app",
            "values": [
              "db:\n  pass: SECRET-helm-values\n"
            ],
            "manifest": "SECRET-helm-manifest"
          },
          "sensitive_attributes": []
        }
      ]
    }
  ]
}
